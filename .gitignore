# This repository is PUBLIC. Nothing secret may ever be committed here. These patterns are a safety net, not a
# substitute for looking at `git status` before every commit.

# private keys and key material
helper_key
release_signing_key*
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
*_ed25519
*_rsa
known_hosts
authorized_keys
allowed_signers.private

# helper packages (they contain a private key), archives, build output
*.zip
*.tar
*.tar.gz
*.tgz
dist/
packages/

# environment and credentials
.env
.env.*
*.secret
*.secrets
credentials*
tokens*
